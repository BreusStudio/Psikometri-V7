{
  "columns": [
    {
      "key": "id",
      "header": "ID User / NIS",
      "sortable": true,
      "render": {
        "type": "text",
        "className": "font-mono font-bold text-slate-800"
      }
    },
    {
      "key": "name",
      "header": "Nama Siswa",
      "sortable": true,
      "render": {
        "type": "text",
        "className": "font-semibold text-slate-800"
      }
    },
    {
      "key": "class_name",
      "header": "Kelas",
      "sortable": true,
      "render": {
        "type": "badge",
        "className": "px-2 py-0.5 rounded text-xs font-bold bg-slate-100 text-slate-700"
      }
    },
    {
      "key": "major",
      "header": "Jurusan",
      "sortable": true,
      "render": {
        "type": "badge",
        "className": "px-2 py-0.5 rounded text-xs font-bold bg-indigo-50 text-indigo-700"
      }
    },
    {
      "key": "cohort",
      "header": "Angkatan",
      "sortable": true,
      "render": {
        "type": "text-fallback",
        "fallback": "-",
        "className": "font-mono text-xs text-slate-600"
      }
    },
    {
      "key": "gender",
      "header": "L/P",
      "render": {
        "type": "text-fallback",
        "fallback": "L",
        "className": "font-bold text-xs"
      }
    },
    {
      "key": "status",
      "header": "Status Tes",
      "sortable": true,
      "render": {
        "type": "student-test-status"
      }
    },
    {
      "key": "password",
      "header": "Password",
      "render": {
        "type": "text-fallback",
        "fallback": "123456",
        "className": "font-mono text-slate-500 font-medium"
      }
    }
  ],
  "fields": [
    {
      "key": "id",
      "label": "ID User / NIS",
      "type": "text",
      "required": true,
      "placeholder": "Contoh: 2024001"
    },
    {
      "key": "name",
      "label": "Nama Lengkap Siswa",
      "type": "text",
      "required": true,
      "placeholder": "Contoh: Ahmad Subagja"
    },
    {
      "key": "class_name",
      "label": "Kelas",
      "type": "dynamic-select-or-text",
      "optionsSource": "classes",
      "required": true
    },
    {
      "key": "major",
      "label": "Jurusan",
      "type": "dynamic-select-or-text",
      "optionsSource": "majors",
      "required": true
    },
    {
      "key": "cohort",
      "label": "Angkatan (Tahun)",
      "type": "dynamic-select-or-number",
      "optionsSource": "cohorts",
      "required": true
    },
    {
      "key": "gender",
      "label": "Jenis Kelamin",
      "type": "select",
      "required": true,
      "options": [
        { "value": "L", "label": "Laki-laki (L)" },
        { "value": "P", "label": "Perempuan (P)" }
      ]
    },
    {
      "key": "testType",
      "label": "Jenis Tes",
      "type": "multi-checkbox",
      "optionsSource": "testTypes",
      "required": false
    },
    {
      "key": "password",
      "label": "Password Login Siswa",
      "type": "text",
      "required": true,
      "placeholder": "Pilihan password default (misal: 123456)"
    }
  ],
  "filters": [
    {
      "key": "cohortFilter",
      "label": "Angkatan",
      "optionsSource": "cohortsFilter",
      "filterField": "cohort",
      "filterType": "string-match"
    },
    {
      "key": "majorFilter",
      "label": "Jurusan",
      "optionsSource": "majorsFilter",
      "filterField": "major",
      "dependsOn": "cohortFilter",
      "hasCascadingOptions": true
    },
    {
      "key": "classFilter",
      "label": "Kelas",
      "optionsSource": "classesFilter",
      "filterField": "class_name",
      "dependsOn": "majorFilter",
      "hasCascadingOptions": true
    },
    {
      "key": "statusFilter",
      "label": "Status Tes",
      "options": [
        { "value": "SELESAI", "label": "Selesai" },
        { "value": "BELUM_TES", "label": "Belum Tes" }
      ],
      "filterField": "status",
      "filterType": "student-test-status-filter"
    }
  ]
}

{
  "columns": [
    {
      "key": "name",
      "header": "Nama Jenis Tes",
      "sortable": true,
      "render": {
        "type": "text",
        "className": "font-bold text-slate-800"
      }
    },
    {
      "key": "duration",
      "header": "Durasi (Menit)",
      "sortable": true,
      "render": {
        "type": "suffix",
        "suffix": " mnt",
        "className": "font-mono text-xs font-semibold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded"
      }
    },
    {
      "key": "questionLimit",
      "header": "Jumlah Soal",
      "sortable": true,
      "render": {
        "type": "suffix",
        "suffix": " soal",
        "className": "font-mono text-xs text-slate-600"
      }
    },
    {
      "key": "scoringEngine",
      "header": "Mesin Scoring",
      "render": {
        "type": "text-fallback",
        "fallback": "standard",
        "className": "text-xs font-mono font-medium text-indigo-800 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100 uppercase"
      }
    },
    {
      "key": "description",
      "header": "Deskripsi Tes",
      "render": {
        "type": "text-fallback",
        "fallback": "-",
        "className": "text-slate-500 text-xs line-clamp-1"
      }
    }
  ],
  "fields": [
    {
      "key": "name",
      "label": "Nama Jenis Tes",
      "type": "text",
      "required": true,
      "placeholder": "Contoh: Tes Minat Bakat Karir"
    },
    {
      "key": "duration",
      "label": "Durasi Pengerjaan (Menit)",
      "type": "number",
      "required": true,
      "placeholder": "45"
    },
    {
      "key": "questionLimit",
      "label": "Batas Jumlah Soal",
      "type": "number",
      "required": true,
      "placeholder": "Contoh: 50"
    },
    {
      "key": "scoringEngine",
      "label": "Mesin Scoring / Evaluasi",
      "type": "select",
      "required": true,
      "defaultValue": "standard",
      "options": [
        { "value": "standard", "label": "Standard (Kognitif/Skor Murni)" },
        { "value": "riasec", "label": "Minat Karir RIASEC" },
        { "value": "vak", "label": "Gaya Belajar VAK" },
        { "value": "multiple_intelligences", "label": "Kecerdasan Majemuk (MI)" },
        { "value": "brain_dominance", "label": "Dominasi Otak Kiri/Kanan" },
        { "value": "work_readiness", "label": "Kesiapan Kerja Vokasi" },
        { "value": "academic_potential", "label": "Potensi Akademik" }
      ]
    },
    {
      "key": "description",
      "label": "Deskripsi Tes",
      "type": "textarea",
      "required": false,
      "placeholder": "Penjelasan mengenai cakupan & tujuan jenis tes ini..."
    }
  ]
}